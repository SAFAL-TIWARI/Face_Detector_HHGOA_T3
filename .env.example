# ==============================================================================
# TRACE // GOA — Environment Configuration
# ==============================================================================
# The system is designed to run 100% local-first without requiring any paid API keys.
# All fields below are OPTIONAL with zero-config local defaults.
# ==============================================================================

# Backend Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Blockchain / EVM Configuration
# Defaults to http://127.0.0.1:8545 (Local Hardhat Node).
# If no external node is running, the server automatically uses an In-Process Simulated EVM.
RPC_URL=http://127.0.0.1:8545

# Optional: Private key for on-chain contract transactions (Hardhat Account #0 default)
# Hardhat test account 0 (public well-known dev key):
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Reverse Image Search Configuration
# Primary: Google Lens via Headless Playwright (No API Key Required!)
# Optional: Bing Visual Search Cognitive Services Key (if you wish to use Bing API instead)
# BING_VISUAL_SEARCH_KEY=your_bing_visual_search_api_key_here
